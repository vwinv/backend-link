# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://link:link@localhost:5432/link_db?schema=public"

# JWT (tokens API après authentification OAuth 2.0 ou locale)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Compte admin backoffice (seed optionnel)
# ADMIN_EMAIL=admin@dropone.pro
# ADMIN_PASSWORD=change-me
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=DropOne

# OAuth 2.0 / OpenID Connect
# IDs clients Google (séparés par des virgules) : Web + iOS + Android
# Le client Web sert aussi à la connexion Google du backoffice.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
# Bundle ID iOS (Sign in with Apple + Universal Links) — identique à Xcode
APPLE_CLIENT_ID=com.mega.dropone
# Team ID Apple Developer (10 caractères) — requis pour Universal Links
APPLE_TEAM_ID=3G878MZ2JV
# Package Android (build.gradle applicationId) + empreintes SHA-256 (upload + Play Console)
ANDROID_APP_PACKAGE=com.mega.dropone
# Upload keystore + App signing key Play Console, séparées par des virgules
ANDROID_APP_SHA256_CERT=03:1D:B9:11:24:22:D0:7D:41:54:EA:4D:BF:34:A0:ED:22:3F:F0:5F:AB:45:06:33:65:15:2A:32:F1:29:5F:F4,80:66:3B:F7:B0:0D:45:4F:DA:EF:DD:B8:2A:1D:77:A5:D9:02:F3:63:71:EB:E3:73:64:F9:EF:B2:3E:79:DE:DD

# URL publique des cartes (QR code dans les passes Wallet)
APP_PUBLIC_URL=https://api.dropone.pro

# Site / landing (liens de clôture tickets support, etc.)
APP_LANDING_URL=https://dropone.pro

# Quota de partages offre gratuite (lifetime). -1 = illimité
FREE_MAX_SHARES=10

# ─── Cloudinary (avatars, logos, photos de cartes) ───────────────────────────
# Sans ces clés, les images restent en local (dev uniquement).
# En prod, Cloudinary est obligatoire (le disque Render est éphémère).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dropone

# ─── E-mail (invitations équipe) ─────────────────────────────────────────────
# Mettre SMTP_ENABLED=false pour désactiver l'envoi (dev sans SMTP)
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DropOne <noreply@dropone.pro>

# ─── PayDunya SoftPay (paiement abonnements) ─────────────────────────────────
# Sans clés → souscription instantanée via /subscriptions/subscribe (tests)
PAYDUNYA_ENABLED=true
# true = review Apple : IAP StoreKit sur iOS uniquement.
# Android / web : Wave / Orange Money restent disponibles.
HIDE_IN_APP_PAYMENTS=false
# Destinataire des demandes d’inscription (défaut contact@mega-sn.com)
# SUBSCRIPTION_REQUESTS_NOTIFY_EMAIL=contact@mega-sn.com
# ─── Apple In-App Purchase (si HIDE_IN_APP_PAYMENTS=true, iOS uniquement) ──
# Identifiants produits App Store Connect (JSON optionnel pour override)
# APPLE_IAP_PRODUCTS={"drop-one-plus:YEARLY":"com.mega.dropone.premium.yearly"}
APPLE_IAP_BUNDLE_ID=com.mega.dropone
# auto | production | sandbox | xcode
APPLE_IAP_ENVIRONMENT=auto
# ID numérique App Store Connect (Apps → App Information → Apple ID).
# Obligatoire pour les reçus Production. TestFlight est souvent Sandbox.
# APPLE_IAP_APP_APPLE_ID=
APPLE_IAP_ROOT_CA_PATH=./certs/AppleRootCA-G3.cer
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Sandbox : https://app.paydunya.com/sandbox-api  |  Live : https://app.paydunya.com
PAYDUNYA_API_BASE_URL=https://app.paydunya.com
PAYDUNYA_STORE_NAME=Drop One
# URL publique joignable par PayDunya (IPN SoftPay). Doit résoudre en DNS.
# Sur DropOne : https://api.dropone.pro (dropone.pro est la landing Vercel)
PUBLIC_API_URL=https://api.dropone.pro
# Optionnel (override)
# PAYDUNYA_CALLBACK_BASE_URL=
# PAYDUNYA_RETURN_URL=
# PAYDUNYA_CANCEL_URL=

# ─── Stripe (legacy, non utilisé si PayDunya est configuré) ──────────────────
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://dropone.pro/premium/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://dropone.pro/premium/cancel

# IDs des prix Stripe (legacy seed)
STRIPE_PRICE_LINK_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_LINK_PREMIUM_YEARLY=price_...
STRIPE_PRICE_LINK_PREMIUM_LIFETIME=price_...
STRIPE_PRICE_LINK_PREMIUM_TEAM_MONTHLY=price_...
STRIPE_PRICE_LINK_PREMIUM_TEAM_YEARLY=price_...
STRIPE_PRICE_LINK_PREMIUM_TEAM_LIFETIME=price_...

# ─── Apple Wallet (PassKit) ──────────────────────────────────────────────────
# Team ID Apple Developer (10 caractères)
APPLE_TEAM_ID=3G878MZ2JV
# Doit être IDENTIQUE au UID du certificat Pass (ex. pass.com.mega.dropone)
APPLE_PASS_TYPE_ID=pass.com.mega.dropone
# Certificat WWDR Apple G4
APPLE_WWDR_CERT_PATH=./certs/AppleWWDRCAG4.pem
# Certificat Pass Type ID (.pem)
APPLE_PASS_SIGNER_CERT_PATH=./certs/pass_certificate.pem
# Clé privée du certificat Pass (.pem)
APPLE_PASS_SIGNER_KEY_PATH=./certs/pass_private_key.pem
# Passphrase si la clé est protégée (laisser vide sinon)
APPLE_PASS_SIGNER_KEY_PASSPHRASE=

# ─── Google Wallet ───────────────────────────────────────────────────────────
# Issuer ID depuis Google Pay & Wallet Console (nombre, ex. 3388…)
GOOGLE_WALLET_ISSUER_ID=
# Suffixe de la classe générique (objet = {ISSUER_ID}.card_{cardId})
GOOGLE_WALLET_CLASS_SUFFIX=dropone_card_v2
# Compte de service : chemin fichier OU JSON inline (Render)
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=./certs/google-wallet-service-account.json
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Origines autorisées pour le JWT (séparées par des virgules)
GOOGLE_WALLET_ORIGINS=https://dropone.pro,https://api.dropone.pro

# ─── Firebase Cloud Messaging (notifications push) ───────────────────────────
# Project ID Firebase (ex. dropone-6c91e)
FIREBASE_PROJECT_ID=dropone-6c91e
# Compte de service Firebase (JSON) — chemin fichier OU JSON inline
FIREBASE_SERVICE_ACCOUNT_PATH=./certs/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
