// Toute évolution de ce schéma DOIT avoir une migration dans prisma/migrations/.
// Interdit : prisma db push. Prod = prisma migrate deploy.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum TeamMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum OfferBillingType {
  MONTHLY
  YEARLY
  LIFETIME
}

enum OfferAudience {
  PERSONAL
  TEAM
}

enum ShareMethod {
  LINK
  QR_CODE
  AIRDROP
  WHATSAPP
  NFC
  EMAIL
}

enum WalletType {
  APPLE_WALLET
  GOOGLE_WALLET
}

enum SubscriptionSignupStatus {
  PENDING
  CONTACTED
  CONVERTED
  CANCELLED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum SupportTicketStatus {
  OPEN
  REPLIED
  CLOSED
}

enum SocialPlatform {
  LINKEDIN
  TWITTER
  INSTAGRAM
  FACEBOOK
  GITHUB
  WEBSITE
  YOUTUBE
  TIKTOK
  WHATSAPP
  CUSTOM
}

enum CardKind {
  PERSONAL
  PROFESSIONAL
  MEMBER
}

enum ContactSource {
  EXCHANGE
  AI_SCAN
}

enum NotificationAudience {
  ALL
  PREMIUM
  FREE
  USER_IDS
}

enum NotificationCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  providerId   String?
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  stripeCustomerId String?      @unique
  role         UserRole     @default(USER)
  isActive     Boolean      @default(true)
  /// Incrémente à la déconnexion / reset MDP pour invalider les JWT existants.
  sessionVersion Int        @default(0)
  adminRoleId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  adminRole            AdminRole?   @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  ownedTeams           Team[]       @relation("TeamOwner")
  teamMemberships      TeamMember[]
  teamInvitesSent      TeamInvite[] @relation("TeamInvitesSent")
  teamInvitesReceived  TeamInvite[] @relation("TeamInvitesReceived")
  businessCards   BusinessCard[]
  subscriptions   Subscription[]
  savedCards      SavedCard[]
  shareEvents     ShareEvent[]
  cardSaveEvents  CardSaveEvent[]
  cardViews       CardView[]
  aiScanEvents    AiScanEvent[]
  contacts        Contact[]
  pushTokens      DevicePushToken[]
  notifications   UserNotification[]
  notificationCampaignsCreated NotificationCampaign[] @relation("NotificationCampaignCreator")
  supportTicketReplies SupportTicketReply[] @relation("SupportTicketReplies")
  paymentInvoices      PaymentInvoice[]
  passwordResetTokens  PasswordResetToken[]
  signupRequests       SubscriptionSignupRequest[]

  @@unique([authProvider, providerId])
  @@index([adminRoleId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Backoffice RBAC ─────────────────────────────────────────────────────────

model AdminPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  label       String
  description String?
  createdAt   DateTime @default(now())

  roles AdminRolePermission[]

  @@index([module])
  @@map("admin_permissions")
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AdminRolePermission[]
  users       User[]

  @@map("admin_roles")
}

model AdminRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  brandColor  String?
  ownerId     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  invites         TeamInvite[]
  businessCards   BusinessCard[]
  subscriptions   Subscription[]
  paymentInvoices PaymentInvoice[]

  @@map("teams")
}

model TeamInvite {
  id            String           @id @default(cuid())
  teamId        String
  email         String
  firstName     String?
  lastName      String?
  jobTitle      String?
  avatarUrl     String?
  invitedById   String
  inviteeUserId String?
  role          TeamMemberRole   @default(MEMBER)
  status        TeamInviteStatus @default(PENDING)
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("TeamInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  invitee   User? @relation("TeamInvitesReceived", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([email, status])
  @@map("team_invites")
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ─── Business Cards ──────────────────────────────────────────────────────────

model BusinessCard {
  id            String   @id @default(cuid())
  slug          String   @unique
  ownerId       String
  teamId        String?
  kind          CardKind @default(PERSONAL)
  firstName     String
  lastName      String
  jobTitle      String?
  company       String?
  bio           String?
  email         String?
  phone         String?
  address       String?
  website       String?
  avatarUrl     String?
  coverImageUrl String?
  logoUrl       String?
  theme         Json     @default("{}")
  isPublic      Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  socialLinks  SocialLink[]
  portfolio    Portfolio?
  savedCards   SavedCard[]
  shareEvents  ShareEvent[]
  cardViews    CardView[]
  cardSaves    CardSaveEvent[]
  contacts     Contact[]

  @@index([ownerId, kind])
  @@map("business_cards")
}

model SocialLink {
  id        String         @id @default(cuid())
  cardId    String
  platform  SocialPlatform
  label     String?
  url       String
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  card BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

// ─── Portfolio ───────────────────────────────────────────────────────────────

model Portfolio {
  id          String   @id @default(cuid())
  cardId      String   @unique
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  card     BusinessCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  projects PortfolioProject[]

  @@map("portfolios")
}

model PortfolioProject {
  id           String   @id @default(cuid())
  portfolioId  String
  title        String
  description  String?
  imageUrl     String?
  projectUrl   String?
  tags         String[] @default([])
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("portfolio_projects")
}

// ─── Subscriptions & Plans ───────────────────────────────────────────────────

model Plan {
  id              String        @id @default(cuid())
  name            String        @unique
  slug            String        @unique
  description     String?
  priceMonthly    Decimal       @db.Decimal(10, 2)
  priceYearly     Decimal       @db.Decimal(10, 2)
  maxCards        Int           @default(1)
  maxTeamMembers  Int           @default(0)
  hasPortfolio    Boolean       @default(false)
  hasCustomDomain Boolean       @default(false)
  hasAnalytics    Boolean       @default(false)
  features        Json          @default("[]")
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String?
  teamId           String?
  planId           String
  offerId          String?
  offerPriceId     String?
  /** Sièges achetés (offres pro tarifées au siège). */
  purchasedSeats   Int?
  status           SubscriptionStatus @default(TRIAL)
  billingPeriod    BillingPeriod      @default(MONTHLY)
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  stripeSubscriptionId   String? @unique
  stripeCheckoutSessionId String?
  paydunyaInvoiceToken   String? @unique
  appleOriginalTransactionId String? @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plan       Plan               @relation(fields: [planId], references: [id])
  offer      PremiumOffer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerPrice PremiumOfferPrice? @relation(fields: [offerPriceId], references: [id], onDelete: SetNull)
  invoices   PaymentInvoice[]

  @@map("subscriptions")
}

model SubscriptionSignupRequest {
  id          String                    @id @default(cuid())
  userId      String
  offerSlug   String
  offerTitle  String
  billingType OfferBillingType
  seats       Int?
  teamId      String?
  status      SubscriptionSignupStatus  @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("subscription_signup_requests")
}

model PaymentInvoice {
  id                String        @id @default(cuid())
  number            String        @unique
  userId            String
  teamId            String?
  subscriptionId    String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("FCFA")
  status            InvoiceStatus @default(PAID)
  description       String?
  offerSlug         String?
  billingType       String?
  seats             Int?
  provider          String?
  providerInvoiceId String?       @unique
  /** Lignes de détail (offre, sièges en plus, etc.). */
  lines             Json          @default("[]")
  /** Date d’échéance (factures à venir / renouvellement). */
  dueAt             DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([status, dueAt])
  @@map("payment_invoices")
}

model PremiumOffer {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  subtitle            String?
  audience            OfferAudience @default(PERSONAL)
  canCustomize        Boolean       @default(false)
  maxTeamMembers      Int           @default(0)
  /** Minimum d’utilisateurs à l’achat (offres TEAM / prix au siège). */
  minSeats            Int           @default(1)
  hasPortfolio        Boolean       @default(false)
  hasWallet           Boolean       @default(false)
  hasAnalytics        Boolean       @default(false)
  hasVisitorInsights  Boolean       @default(false)
  hasSocialLinks      Boolean       @default(false)
  maxAiScans          Int           @default(0)
  maxShares           Int           @default(10)
  sortOrder           Int           @default(0)
  isActive            Boolean       @default(true)
  /** false = hors catalogue app (ex. offre gratuite / défauts). */
  listedInApp         Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  prices        PremiumOfferPrice[]
  subscriptions Subscription[]

  @@map("premium_offers")
}

model PremiumOfferPrice {
  id              String           @id @default(cuid())
  offerId         String
  billingType     OfferBillingType
  priceLabel      String?
  priceAmount     Decimal          @db.Decimal(10, 2)
  /** Si défini (offres pro) : montant = pricePerSeat × sièges. */
  pricePerSeat    Decimal?         @db.Decimal(10, 2)
  currency        String           @default("FCFA")
  discountPercent Int?
  badgeLabel      String?
  isPopular       Boolean          @default(false)
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  stripePriceId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  offer         PremiumOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([offerId, billingType])
  @@map("premium_offer_prices")
}

// ─── Sharing & Wallet ────────────────────────────────────────────────────────

model ShareEvent {
  id        String      @id @default(cuid())
  cardId    String
  userId    String?
  method    ShareMethod
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now())

  card BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("share_events")
}

model SavedCard {
  id         String     @id @default(cuid())
  userId     String
  cardId     String
  walletType WalletType
  passId     String?
  savedAt    DateTime   @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, walletType])
  @@map("saved_cards")
}

model CardView {
  id           String   @id @default(cuid())
  cardId       String
  viewerUserId String?
  source       String?
  ipAddress    String?
  userAgent    String?
  referrer     String?
  viewedAt     DateTime @default(now())

  card   BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  viewer User?        @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([cardId, viewedAt])
  @@index([viewerUserId])
  @@map("card_views")
}

model CardSaveEvent {
  id      String   @id @default(cuid())
  cardId  String
  userId  String?
  savedAt DateTime @default(now())

  card BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("card_save_events")
}

// ─── AI Scans ────────────────────────────────────────────────────────────────

model AiScanEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact?

  @@index([userId, createdAt])
  @@map("ai_scan_events")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id           String        @id @default(cuid())
  userId       String
  source       ContactSource
  firstName    String
  lastName     String
  email        String?
  phone        String?
  jobTitle     String?
  company      String?
  linkedCardId String?
  scanEventId  String?       @unique
  avatarColor  Int           @default(683007)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedCard BusinessCard? @relation(fields: [linkedCardId], references: [id], onDelete: SetNull)
  scanEvent  AiScanEvent?  @relation(fields: [scanEventId], references: [id], onDelete: SetNull)

  @@unique([userId, linkedCardId])
  @@index([userId, createdAt])
  @@map("contacts")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model DevicePushToken {
  id        String       @id @default(cuid())
  userId    String
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_push_tokens")
}

model NotificationCampaign {
  id             String                     @id @default(cuid())
  title          String
  body           String
  audience       NotificationAudience
  userIds        Json                       @default("[]")
  status         NotificationCampaignStatus @default(DRAFT)
  targetCount    Int                        @default(0)
  deliveredCount Int                        @default(0)
  readCount      Int                        @default(0)
  pushAttempted  Int                        @default(0)
  errorMessage   String?
  createdById    String?
  createdAt      DateTime                   @default(now())
  sentAt         DateTime?
  updatedAt      DateTime                   @updatedAt

  createdBy     User?              @relation("NotificationCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  notifications UserNotification[]

  @@index([createdAt])
  @@index([status])
  @@map("notification_campaigns")
}

model UserNotification {
  id         String    @id @default(cuid())
  userId     String
  campaignId String?
  title      String
  body       String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign NotificationCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([campaignId])
  @@map("user_notifications")
}

// ─── Support ─────────────────────────────────────────────────────────────────

model SupportTicket {
  id         String              @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String?
  message    String
  status     SupportTicketStatus @default(OPEN)
  closeToken String              @unique @default(cuid())
  closedAt   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  replies SupportTicketReply[]

  @@index([status, createdAt])
  @@index([email])
  @@map("support_tickets")
}

model SupportTicketReply {
  id           String   @id @default(cuid())
  ticketId     String
  body         String
  sentByUserId String?
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sentBy User?         @relation("SupportTicketReplies", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_ticket_replies")
}

// ─── App update (singleton) ──────────────────────────────────────────────────

/// Config unique pour le prompt de mise à jour in-app (backoffice).
model AppUpdateConfig {
  id              String   @id @default("default")
  latestVersion   String   @default("")
  minVersion      String   @default("")
  iosStoreUrl     String   @default("")
  androidStoreUrl String   @default("")
  message         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("app_update_config")
}

